# 环境变量配置文件
# HTTP 监听端口，也是 docker run -p 要映射的端口。留空则按 8080 跑
PORT=8080

# 数据库。本机开发用 disable；生产走容器或远端库时改成 require，口令由部署环境注入，不要把生产口令写进仓库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=echo_app
DB_PASSWORD=your_password
DB_NAME=echodb
DB_SSLMODE=disable

# JWT 签名密钥，必填。留空服务直接启动失败，不会带着空密钥上线
JWT_SECRET=
# token 有效期（小时）。留空、填 0、填非数字都回落 24。契约里写的是 24 小时，改这个值等于改契约，要先通知前端
JWT_EXPIRE_HOURS=24

# 允许跨域的前端地址，多个用逗号分隔；留空表示放开（当前行为）。
# 注意：这一项还没接进代码，跨域仍写死为 *，接入与匹配逻辑在下一步做，现在设了也不生效
CORS_ALLOW_ORIGIN=
